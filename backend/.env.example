# PostgreSQL 16 connection (create the DB in pgAdmin 4 or psql first)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/ctech_v3

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

PORT=4000
CORS_ORIGIN=http://localhost:5173

# Local-disk uploads (no S3 in this stack)
UPLOADS_DIR=uploads
PUBLIC_UPLOADS_BASE_URL=http://localhost:4000/uploads

# Your company's details, printed on invoices, purchase orders and challans.
# A GST invoice must carry YOUR GSTIN — fill these in before issuing real invoices.
COMPANY_NAME=C-Tech
COMPANY_GSTIN=
COMPANY_ADDRESS=
COMPANY_STATE=Gujarat
COMPANY_PHONE=
COMPANY_EMAIL=
COMPANY_BANK=

# Only needed if pg_dump is not on your PATH (used by Super Admin > Backup).
# Windows example: C:\Program Files\PostgreSQL\16\bin\pg_dump.exe
PG_DUMP_PATH=
