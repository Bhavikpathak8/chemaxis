# ==============================================================================
# C-TECH Institutional Chemical Trading Platform — Production Environment Reference
# Copy to .env in production deployment and populate real secrets.
# ==============================================================================

# Node runtime environment
NODE_ENV=production
PORT=4000

# ------------------------------------------------------------------------------
# 1. Database Connection & Connection Pooling (PostgreSQL 16)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres_user:strong_production_password@postgres:5432/ctech_v3
DB_POOL_MAX=25
DB_POOL_MIN=4
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=5000
DB_MAX_USES=7500

# ------------------------------------------------------------------------------
# 2. JWT Authentication Secrets
# Generate 48-byte cryptographically secure random keys:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET=replace_with_64_char_cryptographically_secure_random_hex_key
JWT_REFRESH_SECRET=replace_with_64_char_cryptographically_secure_random_hex_key
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 3. Security, CORS & Rate Limiting
# ------------------------------------------------------------------------------
CORS_ORIGIN=https://ctech.trade,https://app.ctech.trade,https://admin.ctech.trade
APP_BASE_URL=https://app.ctech.trade
ALLOW_TEST_OTP=false
DISABLE_RATE_LIMIT=false

# ------------------------------------------------------------------------------
# 4. Multi-Provider Transactional Email
# (Configure at least ONE provider for live OTP and notification delivery)
# ------------------------------------------------------------------------------
# Provider A: Nodemailer SMTP (AWS SES / Postmark / SendGrid / Brevo)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_smtp_password_or_api_token
SMTP_FROM="C-Tech Trade Desk" <security@ctech.trade>
SMTP_SECURE=false

# Provider B: Resend REST API
# RESEND_API_KEY=re_123456789
# RESEND_FROM="C-Tech Desk" <onboarding@resend.dev>

# Provider C: SendGrid REST API
# SENDGRID_API_KEY=SG.your_sendgrid_key
# SENDGRID_FROM=security@ctech.trade

# ------------------------------------------------------------------------------
# 5. Multi-Provider SMS Gateways (Indian TRAI / DLT Compliant & International)
# (Configure at least ONE provider for real mobile OTP delivery)
# ------------------------------------------------------------------------------
# Provider A: MSG91 (DLT Flow compliant for India TRAI compliance)
# Register Entity ID, Header (e.g. CTECHT), and Flow Template at https://msg91.com
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_FLOW_ID=your_registered_dlt_flow_id
MSG91_SENDER_ID=CTECHT
MSG91_OTP_TEMPLATE_ID=your_dlt_template_id

# Provider B: Twilio (Global E.164 SMS)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890

# Provider C: Fast2SMS (Indian transactional route)
# FAST2SMS_API_KEY=your_fast2sms_api_key

# ------------------------------------------------------------------------------
# 6. Corporate Identity & GST Invoicing Defaults
# ------------------------------------------------------------------------------
COMPANY_NAME=C-Tech Chemical Trade Desk Private Limited
COMPANY_GSTIN=24AAAAA0000A1Z5
COMPANY_ADDRESS=Plot 104, GIDC Hazira Industrial Estate
COMPANY_CITY=Surat
COMPANY_STATE=Gujarat
COMPANY_PINCODE=394270
COMPANY_PHONE=+91 261 2800000
COMPANY_EMAIL=desk@ctech.trade
COMPANY_BANK=State Bank of India, Hazira Commercial Branch, A/C: 0000000000, IFSC: SBIN0000000

# File Uploads Directory (Persistent storage volume)
UPLOADS_DIR=/usr/src/app/uploads
PUBLIC_UPLOADS_BASE_URL=https://app.ctech.trade/uploads
